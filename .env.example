# Base de datos
# Docker Compose usa el nombre del servicio y el puerto interno de PostgreSQL.
DB_HOST=postgres 
DB_PORT=5432
DB_USER=pqrs_user
DB_PASSWORD=pqrs_pass (Define una clave fuerte para la base de datos)
DB_NAME=pqrs_database
# JWT
JWT_SECRET=cambia-este-secreto
JWT_REFRESH_SECRET=cambia-este-secreto-refresh
JWT_EXPIRES_IN=15m

# Frontend (CORS)
FRONTEND_URL=http://localhost:8081

NGINX_PORT=8081

# Entorno
NODE_ENV=development

# Correo
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu-clave-de-aplicacion

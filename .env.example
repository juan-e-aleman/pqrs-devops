# Base de datos
# Docker Compose usa el nombre del servicio y el puerto interno de PostgreSQL.
DB_HOST=postgres
DB_PORT=5432
DB_USER=pqrs_user
DB_PASSWORD=pqrs_pass
DB_NAME=pqrs

# JWT
JWT_SECRET=cambia-este-secreto
JWT_REFRESH_SECRET=cambia-este-secreto-refresh
JWT_EXPIRES_IN=15m

# Frontend (CORS)
FRONTEND_URL=http://localhost:8080
NGINX_PORT=8080

# Entorno
NODE_ENV=development

# Correo
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu-clave-de-aplicacion

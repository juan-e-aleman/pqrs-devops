# ==========================================
# ENVIRONMENT CONFIGURATION - PQRS DEVOPS
# ==========================================

# PostgreSQL - internal Docker network
DB_HOST=postgres
DB_PORT=5432
DB_USER=pqrs_user
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURA
DB_NAME=pqrs

# Backend environment
NODE_ENV=development

# JWT security
JWT_SECRET=GENERAR_SECRETO_ALEATORIO
JWT_REFRESH_SECRET=GENERAR_OTRO_SECRETO_ALEATORIO
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
BCRYPT_ROUNDS=12

# Frontend and CORS
FRONTEND_URL=http://localhost:8080

# Optional email configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Nginx
NGINX_PORT=8081

# Local development ports
DEV_DB_PORT=5434
DEV_API_PORT=3000
